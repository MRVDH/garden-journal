#!/usr/bin/env bash
# Create the development virtualenv from requirements-dev.txt.
#
# Installs its own CPython 3.14 under ~/.local/share/uv/python and leaves the
# system Python alone. Home Assistant 2026.3 and later require 3.14.2 or newer.
set -euo pipefail

cd "$(dirname "$0")/.."

if ! command -v uv >/dev/null 2>&1; then
    echo "uv is required. See https://docs.astral.sh/uv/getting-started/" >&2
    exit 1
fi

uv python install 3.14
uv venv --python 3.14 .venv
VIRTUAL_ENV=.venv uv pip install -r requirements-dev.txt

echo
echo "Done. Next:"
echo "  scripts/develop            start Home Assistant on localhost:8123"
echo "  .venv/bin/pytest           run the tests"
echo "  .venv/bin/ruff check .     lint"
